# ===================================================
# The Lenny Growth Assistant - Environment Configuration
# ===================================================

# Database (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lenny_growth

# Cloud LLM: Google Gemini
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local LLM: Ollama (Mandatory for local demo)
# Download from https://ollama.com and run `ollama run llama3.2`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Active Default Engine ('gemini' or 'ollama')
DEFAULT_PROVIDER=gemini

# RAG & Embedding Configuration
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Server & Logging
LOG_LEVEL=INFO
ENV=development
